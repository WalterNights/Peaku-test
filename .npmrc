# =============================================================================
# Configuración defensiva de pnpm (supply-chain hardening)
# Documentación: docs/04-seguridad.md §14
# =============================================================================

# --- Determinismo / reproducibilidad ---
# Falla si pnpm-lock.yaml difiere de package.json. Crítico en CI.
frozen-lockfile=true

# --- Cooldown contra paquetes recién publicados ---
# 1440 min = 24 h. Habría mitigado el ataque chalk/debug de Sep-2025
# (revertido en ~2 h) y la mayor parte de los waves de Shai-Hulud.
# Para producción crítica subir a 10080 (7 días).
minimum-release-age=1440

# --- Bloqueo de dependencias de fuentes exóticas (git, tarballs) ---
# pnpm 11+ rechaza subdeps con URLs no-registry por default; reafirmamos.
block-exotic-subdeps=true

# --- Policy de confianza DESHABILITADA por pragmatismo ---
# trust-policy=no-downgrade es demasiado estricto en el ecosistema JS actual:
# bloquea paquetes legítimos que simplemente no tienen npm provenance
# attestation (feature nuevo, ~2023). La defensa real contra ataques activos
# es minimum-release-age (cooldown 24h) que SÍ mantenemos.
# trust-policy=no-downgrade

# --- Peer deps ---
strict-peer-dependencies=true
auto-install-peers=true

# --- Lifecycle scripts (pre/post) ---
# pnpm 11 los desactiva por default por seguridad. Los necesitamos para
# que `predev`/`predev:backend` se ejecuten antes de los dev scripts.
enable-pre-post-scripts=true

# --- pnpm deploy: el flag --legacy se pasa explícitamente en los Dockerfiles ---
# `force-legacy-deploy=true` aquí NO funcionó (pnpm 11.1.3 lo ignora silente).
# Solución: pasar `--legacy` directo en el comando `pnpm deploy` (ver Dockerfiles).

# --- Logs verbosos ante warnings de seguridad ---
loglevel=warn

# --- Registry oficial (fijar explícito para evitar mirror inseguro) ---
registry=https://registry.npmjs.org/

# --- Ignorar scripts NO globalmente: usamos onlyBuiltDependencies en package.json
# para una lista blanca explícita. pnpm 10+ bloquea por default los demás.
