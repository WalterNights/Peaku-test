              "path": ["api", "v1", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has paginated shape', () => {",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.total).to.be.a('number');",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.limit).to.eql(20);",
                  "  pm.expect(body.totalPages).to.be.a('number');",
                  "});",
                  "pm.test('Seed loaded ≥ 10 products', () => pm.expect(body.total).to.be.at.least(10));",
                  "if (body.items.length > 0) {",
                  "  const p = body.items[0];",
