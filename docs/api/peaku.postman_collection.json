{
  "info": {
    "_postman_id": "7e3b1d4a-2c5f-4b9e-a1d8-3e4f5a6b7c8d",
    "name": "PeaKu API — End-to-End Tests",
    "description": "Colección completa con tests automatizados para el backend de PeaKu (gateway + auth + products). Cubre happy paths, errores esperados (4xx/5xx) y autorización por rol.\n\n## Cómo correr\n\n1. Levantar el stack: `pnpm docker:up`\n2. Cargar datos demo: `pnpm seed`\n3. Importar este archivo + `peaku.postman_environment.json` en Postman.\n4. Seleccionar el environment 'PeaKu — Local'.\n5. Run Collection (sequencial) o Newman desde CLI.\n\nLos tests guardan tokens/IDs en variables del environment automáticamente, así que las requests posteriores los reutilizan sin intervención manual.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health (gateway)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Service is api-gateway', () => pm.expect(body.service).to.eql('api-gateway'));",
                  "pm.test('Status field is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('Has ISO timestamp', () => pm.expect(body.timestamp).to.match(/^\\d{4}-\\d{2}-\\d{2}T/));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth — Happy Path",
      "item": [
        {
          "name": "POST /auth/register (test user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 if first time, 409 if rerun. Both are acceptable.",
                  "pm.test('Status is 201 or 409 (idempotent rerun)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Response has id and email', () => {",
                  "    pm.expect(body.id).to.be.a('string');",
                  "    pm.expect(body.email).to.eql(pm.environment.get('testUserEmail'));",
                  "  });",
                  "  pm.test('passwordHash NOT in response', () => {",
                  "    pm.expect(body).to.not.have.property('passwordHash');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has accessToken and refreshToken', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.match(/^eyJ/);",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.match(/^eyJ/);",
                  "});",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);",
                  "// Decode JWT to verify role=admin",
                  "const payload = JSON.parse(Buffer.from(body.accessToken.split('.')[1], 'base64').toString());",
                  "pm.test('JWT role is admin', () => pm.expect(payload.role).to.eql('admin'));",
                  "pm.test('JWT has iss/aud', () => {",
                  "  pm.expect(payload.iss).to.eql('peaku-auth');",
                  "  pm.expect(payload.aud).to.eql('peaku-api');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (test user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('userAccessToken', body.accessToken);",
                  "const payload = JSON.parse(Buffer.from(body.accessToken.split('.')[1], 'base64').toString());",
                  "pm.test('JWT role is user (NOT admin)', () => pm.expect(payload.role).to.eql('user'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Email matches admin', () => pm.expect(body.email).to.eql(pm.environment.get('adminEmail')));",
                  "pm.test('Role is admin', () => pm.expect(body.role).to.eql('admin'));",
                  "pm.test('No password fields exposed', () => {",
                  "  pm.expect(body).to.not.have.property('passwordHash');",
                  "  pm.expect(body).to.not.have.property('refreshTokenHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh (rotation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const oldAccess = pm.environment.get('accessToken');",
                  "const oldRefresh = pm.environment.get('refreshToken');",
                  "pm.test('New tokens are different (rotation)', () => {",
                  "  pm.expect(body.accessToken).to.not.eql(oldAccess);",
                  "  pm.expect(body.refreshToken).to.not.eql(oldRefresh);",
                  "});",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
