  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request — runs before each request in the collection",
          "// Add a correlation-id so we can trace each request end-to-end",
          "if (!pm.request.headers.has('x-correlation-id')) {",
          "  pm.request.headers.add({",
          "    key: 'x-correlation-id',",
          "    value: 'postman-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8)",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global post-request — runs after each request",
          "pm.test('Response includes correlation-id header', () => {",
          "  pm.expect(pm.response.headers.get('x-correlation-id')).to.not.be.null;",
          "});"
        ]
      }
    }
  ]
