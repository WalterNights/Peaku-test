    {
      "name": "4. Products — Admin Mutations",
      "item": [
        {
          "name": "POST /products (admin) → 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"E2E-TEST-{{$timestamp}}\",\n  \"name\": \"Producto E2E Test\",\n  \"description\": \"Creado por la collection Postman\",\n  \"price\": 99.99,\n  \"stock\": 10,\n  \"category\": \"otros\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a unique SKU for this run",
                  "pm.environment.set('newProductSku', 'E2E-TEST-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response has product fields', () => {",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.sku).to.match(/^E2E-TEST-/);",
                  "  pm.expect(body.name).to.eql('Producto E2E Test');",
                  "  pm.expect(body.price).to.eql(99.99);",
                  "  pm.expect(body.stock).to.eql(10);",
                  "  pm.expect(body.isActive).to.be.true;",
                  "});",
                  "pm.environment.set('createdProductId', body.id);",
                  "pm.environment.set('createdProductSku', body.sku);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /products (SKU duplicado) → 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
