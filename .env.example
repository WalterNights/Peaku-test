# ============================================================================
#  PeaKu — Variables de entorno
#  Copiar a .env y completar. NUNCA versionar .env real.
# ============================================================================

# --- Entorno ---
NODE_ENV=development

# --- MongoDB (auth-service) ---
MONGO_AUTH_HOST=mongo-auth
MONGO_AUTH_PORT=27017
MONGO_AUTH_USER=auth_admin
MONGO_AUTH_PASSWORD=changeme_auth_strong_password
MONGO_AUTH_DB=peaku_auth
MONGO_AUTH_URI=mongodb://auth_admin:changeme_auth_strong_password@mongo-auth:27017/peaku_auth?authSource=admin
# URI desde la host machine (para seed scripts locales)
MONGO_AUTH_URI_LOCAL=mongodb://auth_admin:changeme_auth_strong_password@127.0.0.1:27017/peaku_auth?authSource=admin

# --- MongoDB (products-service) ---
MONGO_PRODUCTS_HOST=mongo-products
MONGO_PRODUCTS_PORT=27017
MONGO_PRODUCTS_USER=products_admin
MONGO_PRODUCTS_PASSWORD=changeme_products_strong_password
MONGO_PRODUCTS_DB=peaku_products
MONGO_PRODUCTS_URI=mongodb://products_admin:changeme_products_strong_password@mongo-products:27017/peaku_products?authSource=admin
# URI desde la host machine (puerto 27018 para no chocar con mongo-auth)
MONGO_PRODUCTS_URI_LOCAL=mongodb://products_admin:changeme_products_strong_password@127.0.0.1:27018/peaku_products?authSource=admin

# --- JWT (compartido entre auth-service y api-gateway) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CHANGE_ME_minimum_32_chars_random_base64_secret_here
JWT_REFRESH_SECRET=CHANGE_ME_different_minimum_32_chars_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=peaku-auth
JWT_AUDIENCE=peaku-api

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Puertos ---
GATEWAY_PORT=4050
AUTH_PORT=3001
PRODUCTS_PORT=3002
FRONTEND_PORT=4200

# --- URLs internas (Docker network) ---
AUTH_SERVICE_URL=http://auth-service:3001
PRODUCTS_SERVICE_URL=http://products-service:3002
# URLs desde host machine (para gateway corriendo local fuera de Docker)
AUTH_SERVICE_URL_LOCAL=http://127.0.0.1:3001
PRODUCTS_SERVICE_URL_LOCAL=http://127.0.0.1:3002

# --- Token interno entre gateway y servicios (defensa adicional) ---
INTERNAL_API_KEY=CHANGE_ME_internal_service_to_service_secret

# --- CORS (whitelist separada por coma) ---
CORS_ORIGINS=http://localhost:4200

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_LIMIT=10

# --- Swagger ---
SWAGGER_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
